# RAVAL environment-variable template. No secrets are included.
# This file is NOT loaded automatically. Set variables in your shell or process.
# Default local demo: deterministic fixture; no model API or Telegram connection.

QUOTE_LLM_PROVIDER=fixture
QUOTE_LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
QUOTE_ANNUAL_RATE=23

# Optional local paths; leave unset to use the project defaults.
# QUOTE_CSV_PATH=/absolute/path/to/prices.csv
# QUOTE_DB_PATH=/absolute/path/to/workflow.sqlite3

# Optional test bot. Allowed IDs are positive private-chat IDs, comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_STATE_DB=/absolute/path/to/telegram.sqlite3

